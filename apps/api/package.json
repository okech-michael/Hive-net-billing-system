{
  "name": "@hivenet/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.2.1",
    "argon2": "0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.7",
    "helmet": "8.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.14",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "dotenv-cli": "8.0.0",
    "jest": "29.7.0",
    "prisma": "6.2.1",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
