generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_OWNER
  TENANT_ADMIN
  NETWORK_OPERATOR
  FINANCE_OPERATOR
  SUPPORT_AGENT
  REPORT_VIEWER
}

enum PaymentStatus {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REVERSED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING_NETWORK
}

enum NetworkStatus {
  PENDING
  AUTHORIZED
  DISCONNECTED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  active      Boolean   @default(true)
  branding    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  sites       Site[]
  packages    InternetPackage[]
  customers   Customer[]
  orders      PaymentOrder[]
  entitlements Entitlement[]
  auditLogs   AuditLog[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @db.Uuid
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(SUPPORT_AGENT)
  active       Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Site {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  routers     Router[]
  packages    InternetPackage[]
  customers   Customer[]
  orders      PaymentOrder[]
  entitlements Entitlement[]
  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Router {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  siteId          String   @db.Uuid
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name            String
  host            String
  apiPort         Int      @default(8729)
  username        String
  encryptedSecret String
  enabled         Boolean  @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  networkSessions NetworkSession[]
  @@unique([siteId, name])
  @@index([tenantId, siteId])
}

model InternetPackage {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  siteId             String?  @db.Uuid
  site               Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  priceMinor         Int
  currency           String   @default("KES")
  durationSeconds    Int
  downloadKbps       Int?
  uploadKbps         Int?
  deviceLimit        Int      @default(1)
  dataLimitBytes     BigInt?
  extensionAfterExpiry Boolean @default(false)
  visible            Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             PaymentOrder[]
  @@index([tenantId, visible, sortOrder])
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  siteId      String?  @db.Uuid
  site        Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  phone       String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      PaymentOrder[]
  entitlements Entitlement[]
  sessions    NetworkSession[]
  tickets     SupportTicket[]
  @@unique([tenantId, phone])
  @@index([tenantId, siteId])
}

model PaymentOrder {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId           String        @db.Uuid
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  packageId            String        @db.Uuid
  package              InternetPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  siteId               String?       @db.Uuid
  site                 Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  amountMinor          Int
  currency             String
  packageSnapshot      Json
  phone                String
  idempotencyKey       String
  status               PaymentStatus @default(INITIATED)
  merchantRequestId    String?       @unique
  checkoutRequestId    String?       @unique
  providerReceipt      String?       @unique
  providerResponseCode String?
  providerResult       Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  entitlement          Entitlement?
  outboxEvents         OutboxEvent[]
  callbacks            PaymentCallback[]
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([customerId, createdAt])
}

model PaymentCallback {
  id                String       @id @default(uuid()) @db.Uuid
  orderId           String       @db.Uuid
  order             PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  checkoutRequestId String       @unique
  body              Json
  receivedAt        DateTime     @default(now())
  processedAt       DateTime?
  attempts          Int          @default(0)
  @@index([processedAt, receivedAt])
}

model Entitlement {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId  String            @db.Uuid
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId      String?           @db.Uuid
  site        Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  orderId     String            @unique @db.Uuid
  order       PaymentOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status      EntitlementStatus @default(PENDING_NETWORK)
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  sessions    NetworkSession[]
  @@index([tenantId, customerId, status, expiresAt])
}

model NetworkSession {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  customerId     String        @db.Uuid
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  entitlementId  String        @db.Uuid
  entitlement    Entitlement   @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  routerId       String?       @db.Uuid
  router         Router?       @relation(fields: [routerId], references: [id], onDelete: SetNull)
  status         NetworkStatus @default(PENDING)
  macAddress     String?
  ipAddress      String?
  sessionRef     String?
  bytesIn        BigInt        @default(0)
  bytesOut       BigInt        @default(0)
  startedAt      DateTime?
  lastSeenAt     DateTime?
  endedAt        DateTime?
  createdAt      DateTime      @default(now())
  @@index([tenantId, customerId, status])
  @@index([routerId, status])
}

model SupportTicket {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  customerId  String       @db.Uuid
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  priority    String       @default("normal")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([tenantId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String?  @db.Uuid
  order       PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  dedupeKey   String   @unique
  type        String
  payload     Json
  processedAt DateTime?
  attempts    Int      @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt   DateTime @default(now())
  @@index([processedAt, createdAt])
}
